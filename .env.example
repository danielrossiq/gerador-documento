# Copie para .env (docker compose lê automaticamente). NUNCA versione o .env com segredos reais.
# Tudo abaixo tem padrão para desenvolvimento; em produção defina valores próprios.

APP_ENV=development                 # development | test | production (production exige SECRET_KEY própria e COOKIE_SECURE=true)
SECRET_KEY=troque-por-um-valor-aleatorio-de-32+-bytes
COOKIE_SECURE=false                 # true atrás de HTTPS

# Portas no host (Postgres/Redis não são publicados)
WEB_PORT=3000
API_PORT=8100
MINIO_CONSOLE_PORT=9101

# Banco / fila / armazenamento
POSTGRES_USER=minuta
POSTGRES_PASSWORD=minuta
POSTGRES_DB=minuta
MINIO_ROOT_USER=minuta
MINIO_ROOT_PASSWORD=minuta-secret-123
S3_BUCKET=minuta

# IA (opcional). Sem chave o app usa APENAS regras determinísticas + heurísticas locais (a UI informa isso).
# Recomendado: OpenRouter (D33). A chave NÃO vai aqui: fica num arquivo fora do repositório e entra no stack como
# secret pelo docker-compose.ai.yml (OPENROUTER_KEY_PATH=~/.minuta/openrouter.key). Ver docs/IA.md.
# AI_PROVIDER: auto | local | openrouter | anthropic | none   (auto = OpenRouter se houver chave)
AI_PROVIDER=auto
# Modelos escolhidos por custo x acerto (docs/IA.md e docs/ai/avaliacao-modelos.md):
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5        # achar os campos no documento enviado
# OPENROUTER_ASSIST_MODEL=google/gemini-2.5-flash    # preencher a partir de texto colado e revisar antes de gerar
# AI_MAX_CALL_USD=0.05                # teto por chamada (custo máximo estimado antes de chamar)
# AI_MONTHLY_BUDGET_USD=20            # teto do mês somando todos os espaços; ao atingir, volta às regras locais
# Anthropic direto (alternativa à OpenRouter):
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
# AI_BASE_URL=https://api.anthropic.com
# AI_TIMEOUT_SECONDS=30
# AI_MAX_RETRIES=2
# AI_MAX_CHARS=60000

# Classificação semântica de papéis para o auto-detect de kits (opcional; ver docs/DECISIONS.md D24).
# Sem TYPESAFE_API_KEY, o auto-detect usa só a heurística local por similaridade de rótulo.
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_TIMEOUT_SECONDS=12

# Travas do piloto — padrão: desligadas.
# EXTERNAL_AI_ENABLED=true libera Anthropic/TypeSafe (com as chaves acima). Desligado, nada sai do servidor,
# mesmo com AI_PROVIDER=anthropic e chaves preenchidas.
# EXTERNAL_AI_ENABLED=false
# PDF_IMPORT_ENABLED=true aceita PDF digitado como modelo. Só ligar com a conversão isolada de verdade
# (contêiner/sandbox sem rede); ver docs/SECURITY_AND_LGPD.md.
# PDF_IMPORT_ENABLED=false
# Métricas de ativação AGREGADAS (D32): opt-in. Só contagens por dia/coorte, sem identificadores, supressão < 5,
# retenção de 30 dias. Ligar só com a base legal e o aviso aos participantes do piloto definidos.
# ACTIVATION_METRICS_ENABLED=false

# Recuperação de jobs após queda do worker (heartbeat + watchdog; ver docs/DECISIONS.md D22)
# JOB_HEARTBEAT_SECONDS=10            # sinal de vida do executor
# JOB_STALE_SECONDS=60                # job 'processing' sem heartbeat há isto é retomado (mantenha >= 3x o heartbeat)
# JOB_QUEUE_GRACE_SECONDS=300         # job 'queued' não assumido há isto (mensagem perdida) é reenfileirado
# WATCHDOG_INTERVAL_SECONDS=15

# Pagamentos (Stripe; ver docs/PAGAMENTOS.md). Desligado: todos usam os limites padrão e a tela de planos
# mostra "em configuração". Use chaves de TESTE (sk_test_…) até o go-live.
# BILLING_ENABLED=false
# BILLING_PIX_ENABLED=false           # só depois que a Stripe liberar Pix na conta (por convite)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=              # whsec_… do endpoint https://SEU_DOMINIO/api/v1/billing/webhook
# STRIPE_PRICE_PROFISSIONAL_MENSAL=   # price_… (R$ 49,90/mês)
# STRIPE_PRICE_PROFISSIONAL_ANUAL=    # price_… (R$ 478,80/ano)
# STRIPE_PRICE_ESCRITORIO_MENSAL=     # price_… (R$ 99,90/mês)
# STRIPE_PRICE_ESCRITORIO_ANUAL=      # price_… (R$ 958,80/ano)

# Retenção dos arquivos gerados (dias) e demo
FILE_RETENTION_DAYS=7
SEED_DEMO=true                      # cria usuário/dados de demonstração na primeira subida
SEED_DEMO_PASSWORD=demo12345

# E-mail de recuperação de senha (opcional; sem SMTP_HOST o link aparece no log em desenvolvimento)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@seudominio.com

# Somente para rodar SEM Docker (ver README): SQLite + storage local + jobs em threads
# DATABASE_URL=sqlite:///./data/dev.db
# STORAGE_BACKEND=local
# JOB_BACKEND=thread
# PDF_CONVERTER=none               # ou libreoffice, se soffice estiver no PATH
